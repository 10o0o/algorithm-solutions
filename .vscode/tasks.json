{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Companion: Start problem router",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-u",
                "${workspaceFolder}/scripts/companion_router.py",
                "--open"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            },
            "problemMatcher": {
                "owner": "companion-router",
                "pattern": {
                    "regexp": "^(.+):(\\d+): (.+)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Companion router starting",
                    "endsPattern": "^Companion router ready"
                }
            }
        },
    {
      "label": "Spec Kit: Check",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/scripts/speckit-workflow.sh",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Spec Kit: Start",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/scripts/speckit-workflow.sh",
        "run",
        "${input:speckitFeature}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "Spec Kit: Status",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/scripts/speckit-workflow.sh",
        "status"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Spec Kit: Resume",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/scripts/speckit-workflow.sh",
        "resume",
        "${input:speckitRunId}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      }
    }
    ],
  "inputs": [
    {
      "id": "speckitFeature",
      "type": "promptString",
      "description": "새로 개발할 기능 설명"
    },
    {
      "id": "speckitRunId",
      "type": "promptString",
      "description": "Status에 표시된 실제 Run ID"
    }
  ]
}
