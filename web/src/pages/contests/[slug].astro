---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import Connections from '../../components/Connections.astro';
import { getRecords, relatedRecords, type PublicRecord } from '../../lib/content';
import { repositoryFileUrl, withBase } from '../../lib/urls';
export async function getStaticPaths() { const records = await getRecords(); return records.filter((record) => record.kind === 'contest').map((record) => ({ params: { slug: record.id } })); }
const records = await getRecords();
const record = records.find((item) => item.kind === 'contest' && item.id === Astro.params.slug) as PublicRecord;
const connected = relatedRecords(record, records);
const { Content, headings } = await render(record.entry as CollectionEntry<'contests'>);
---
<Layout title={record.title} description={record.summary}><div class="page-width article-shell"><nav class="breadcrumbs" aria-label="현재 위치"><a href={withBase('/contests/')}>대회</a><span>/</span><span>복기</span></nav><div class="article-grid"><article class="public-article" data-pagefind-body><header class="article-header"><p class="eyebrow" data-pagefind-filter="type">대회</p><h1 data-pagefind-meta="title">{record.title}</h1><div class="article-meta" data-pagefind-ignore><time datetime={record.updated}>{record.updated.replaceAll('-', '.')}</time><span>·</span><a href={record.url}>대회 원문 ↗</a><span>·</span><a href={repositoryFileUrl(record.sourcePath)}>노트 원문 ↗</a></div><div class="tags" data-pagefind-ignore>{record.tags.map((tag) => <a href={`${withBase('/search/')}?tag=${encodeURIComponent(tag)}`} data-pagefind-filter="tag">#{tag}</a>)}</div></header><ArticleToc headings={headings} mobile /><div class="prose"><Content /></div></article><ArticleToc headings={headings} /></div><Connections records={connected} /></div></Layout>
