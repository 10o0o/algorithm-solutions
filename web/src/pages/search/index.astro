---
import Layout from '../../layouts/Layout.astro';
import RecordCard from '../../components/RecordCard.astro';
import { PLATFORMS, areasFor, getRecords } from '../../lib/content';
import { recordUrl, withBase } from '../../lib/urls';
const records = await getRecords();
const areas = areasFor(records);
const tags = [...new Set(records.flatMap((record) => record.tags))].sort((a, b) => a.localeCompare(b, 'ko'));
const searchable = records.map(({ key, kind, id, title, updated, tags, area, platform, summary }) => ({ key, kind, id, title, updated, tags, area, platform, summary, url: recordUrl(kind, id) }));
---
<Layout title="전체 기록 검색"><div class="page-width library-page"><div class="page-intro"><p class="eyebrow">SEARCH THE LIBRARY</p><h1>개념·문제·대회 노트를 한 번에 찾기.</h1><p>노트 본문 검색과 기록 종류, 분야, 플랫폼, 태그 필터를 함께 사용할 수 있습니다.</p></div><form id="library-form" class="library-controls" action={withBase('/search/')}><div class="search-form"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><label class="sr-only" for="query">검색어</label><input id="query" name="q" type="search" placeholder="개념·문제·대회 노트 검색" autocomplete="off"/><button type="submit">검색 →</button></div><div class="filter-row"><div class="filter-group"><label for="type">종류</label><select id="type" name="type"><option value="">전체 종류</option><option value="concept">개념</option><option value="problem">문제</option><option value="contest">대회</option></select></div><div class="filter-group"><label for="area">분야</label><select id="area" name="area"><option value="">전체 분야</option>{areas.map((area) => <option value={area.id}>{area.label}</option>)}</select></div><div class="filter-group"><label for="platform">플랫폼</label><select id="platform" name="platform"><option value="">전체 플랫폼</option>{PLATFORMS.map((platform) => <option value={platform.id}>{platform.label}</option>)}</select></div><div class="filter-group"><label for="tag">태그</label><select id="tag" name="tag"><option value="">전체 태그</option>{tags.map((tag) => <option value={tag}>{tag}</option>)}</select></div><div class="filter-group sort-group"><label for="sort">정렬</label><select id="sort" name="sort"><option value="updated">최근 수정순</option><option value="title">제목순</option></select></div><a class="reset-filters" href={withBase('/search/')}>초기화</a></div></form><div class="results-heading"><h2>전체 기록</h2><p id="result-status" class="quiet" role="status" aria-live="polite">{records.length}개의 문서</p></div><div id="record-results" class="record-grid">{records.map((record) => <div data-record-key={record.key}><RecordCard record={record} /></div>)}</div><div id="search-results" class="search-results" hidden></div><div id="empty-results" class="empty-state" hidden><span aria-hidden="true">⌕</span><h2>일치하는 기록이 없습니다.</h2><p>검색어나 필터를 바꿔보세요.</p><a class="text-link" href={withBase('/search/')}>전체 기록 보기 →</a></div><noscript><p class="notice">검색과 필터에는 JavaScript가 필요합니다. 아래 전체 기록은 JavaScript 없이도 읽을 수 있습니다.</p></noscript></div><script is:inline id="record-data" type="application/json" set:html={JSON.stringify({ records: searchable, base: withBase('/') }).replaceAll('<', '\\u003c')} /><script src="../../scripts/search.ts"></script></Layout>
