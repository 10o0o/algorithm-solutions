---
import Layout from '../layouts/Layout.astro';
import RecordCard from '../components/RecordCard.astro';
import SearchForm from '../components/SearchForm.astro';
import { areasFor, getRecords } from '../lib/content';
import { withBase } from '../lib/urls';
const records = await getRecords();
const concepts = records.filter((record) => record.kind === 'concept');
const areas = areasFor(records);
const recentConcepts = concepts.slice(0, 3);
const recentProblems = records.filter((record) => record.kind === 'problem').slice(0, 3);
---
<Layout>
  <div class="home-hero page-width">
    <div><p class="eyebrow"><span class="status-dot"></span> SOLVE, EXPLAIN, CONNECT</p><h1>한 문제의 풀이에서,<br/><span>다음 발상으로.</span></h1><p class="hero-description">알고리즘의 원리와 실제 풀이를 함께 기록합니다.<br/>왜 맞는지 설명하고, 연결하고, 다시 풀어봅니다.</p><SearchForm large /></div>
    <div class="hero-visual" aria-hidden="true"><div class="orbit one"></div><div class="orbit two"></div><svg class="hero-lines" viewBox="0 0 420 320"><path d="M75 72 204 152 345 60M204 152 340 260M204 152 70 270"/><circle cx="204" cy="152" r="6"/></svg><div class="hero-node"><span>01 / BASICS</span><strong>기초</strong></div><div class="hero-node"><span>02 / SEARCH</span><strong>탐색</strong></div><div class="hero-node"><span>03 / GRAPHS</span><strong>그래프</strong></div><div class="hero-node"><span>04 / PRACTICE</span><strong>문제 풀이</strong></div></div>
  </div>
  <div class="page-width home-content">
    <section class="area-section" aria-labelledby="area-heading"><div class="section-heading"><div><p class="eyebrow">EXPLORE BY SUBJECT</p><h2 id="area-heading">분야별로 둘러보기</h2></div><span class="quiet">{concepts.length}개의 개념 · {areas.length}개의 분야</span></div><div class="area-grid">{areas.map((area) => <a class="area-card" href={`${withBase('/knowledge/')}?area=${area.id}`}><span class="area-symbol" aria-hidden="true">{area.symbol}</span><div><h3>{area.label}</h3><p>{area.description}</p></div><span class="area-count">{concepts.filter((note) => note.area === area.id).length} ↗</span></a>)}</div></section>
    <section aria-labelledby="concept-heading"><div class="section-heading"><div><p class="eyebrow">RECENT CONCEPTS</p><h2 id="concept-heading">최근 다듬은 개념</h2></div><a class="text-link" href={withBase('/knowledge/')}>모든 개념 보기 →</a></div><div class="record-grid">{recentConcepts.map((record) => <RecordCard record={record} />)}</div></section>
    <section aria-labelledby="problem-heading"><div class="section-heading"><div><p class="eyebrow">RECENT PROBLEMS</p><h2 id="problem-heading">최근 정리한 문제</h2></div><a class="text-link" href={withBase('/problems/')}>모든 문제 보기 →</a></div><div class="record-grid">{recentProblems.map((record) => <RecordCard record={record} />)}</div></section>
  </div>
</Layout>
