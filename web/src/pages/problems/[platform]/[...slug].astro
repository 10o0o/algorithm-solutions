---
import { render, type CollectionEntry } from 'astro:content';
import { codeToHtml } from 'shiki';
import Layout from '../../../layouts/Layout.astro';
import ArticleToc from '../../../components/ArticleToc.astro';
import Connections from '../../../components/Connections.astro';
import { PLATFORMS, getRecords, readProblemSolution, relatedRecords, type PublicRecord } from '../../../lib/content';
import { repositoryFileUrl, withBase } from '../../../lib/urls';
export async function getStaticPaths() {
  const records = await getRecords();
  return records.filter((record) => record.kind === 'problem').map((record) => ({ params: { platform: record.platform!, slug: record.id.split('/').slice(1).join('/') } }));
}
const records = await getRecords();
const record = records.find((item) => item.kind === 'problem' && item.id === `${Astro.params.platform}/${Astro.params.slug}`) as PublicRecord;
const connected = relatedRecords(record, records);
const { Content, headings } = await render(record.entry as CollectionEntry<'problems'>);
const platform = PLATFORMS.find((item) => item.id === record.platform);
const solution = await readProblemSolution(record);
const highlighted = await codeToHtml(solution.source, { lang: 'python', themes: { light: 'github-light', dark: 'github-dark' } });
---
<Layout title={record.title} description={record.summary}><div class="page-width article-shell"><nav class="breadcrumbs" aria-label="현재 위치"><a href={withBase('/problems/')}>문제</a><span>/</span><a href={`${withBase('/search/')}?type=problem&platform=${record.platform}`}>{platform?.label}</a></nav><div class="article-grid"><article class="public-article" data-pagefind-body><header class="article-header"><p class="eyebrow" data-pagefind-filter="type">문제</p><span hidden data-pagefind-filter="platform">{record.platform}</span><h1 data-pagefind-meta="title">{record.title}</h1><div class="article-meta" data-pagefind-ignore><span>최근 수정 <time datetime={record.updated}>{record.updated.replaceAll('-', '.')}</time></span><span>·</span><a href={record.url}>문제 원문 ↗</a><span>·</span><a href={repositoryFileUrl(record.sourcePath)}>노트 원문 ↗</a></div><div class="tags" data-pagefind-ignore>{record.tags.map((tag) => <a href={`${withBase('/search/')}?tag=${encodeURIComponent(tag)}`} data-pagefind-filter="tag">#{tag}</a>)}</div></header><ArticleToc headings={headings} mobile /><div class="prose"><Content /></div><section class="solution-section" data-pagefind-ignore><div class="solution-heading"><div><p class="eyebrow">READ-ONLY SOURCE</p><h2>Python 풀이</h2></div><a class="text-link" href={repositoryFileUrl(solution.relative)}>GitHub에서 원본 보기 ↗</a></div><div class="solution-code" set:html={highlighted} /></section></article><ArticleToc headings={headings} /></div><Connections records={connected} /></div></Layout>
